                    "seg 1 · 1080p",
                    "seg 2 · 1080p",
                    "seg 3 · 480p",
                    "seg 4 · 720p"
                  ]
                },
                "note": "Network recovers → step back up"
              }
            ]
          }
        },
        {
          "type": "recap",
          "say": "To recap. Upload in chunks, straight to storage, with presigned URLs. Transcode as a DAG, with outputs in parallel. Cut segments and a manifest per quality. And serve from CDN edges, with the player adapting the bitrate segment by segment.",
          "props": {
            "title": "YouTube, <em>in four lines</em>",
            "items": [
