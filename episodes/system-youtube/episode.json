              }
            ],
            "panels": [],
            "steps": [
              {
                "at": "orchestrator",
                "nodes": {
                  "orch": "active"
                },
                "edges": {
                  "queue-orch": "relax"
                },
                "note": "Orchestrator (e.g. Step Functions, Airflow) runs a DAG"
              },
              {
                "at": "inspects",
                "nodes": {
                  "orch": "base",
                  "insp": "active"
                },
                "edges": {
                  "queue-orch": "base",
                  "orch-insp": "relax"
                },
                "note": "Inspect codec, resolution, fps → choose outputs"
              },
              {
                "at": "parallel",
                "nodes": {
                  "insp": "base",
                  "t1": "active",
                  "t2": "active",
                  "t3": "active"
                },
                "edges": {
                  "orch-insp": "base",
                  "insp-t1": "relax",
                  "insp-t2": "relax",
                  "insp-t3": "relax"
                },
                "note": "Transcode in parallel, + thumbnails"
              },
              {
                "at": "segments",
                "nodes": {
                  "t1": "done",
                  "t2": "done",
                  "t3": "done",
                  "pkg": "active"
                },
                "edges": {
                  "insp-t1": "base",
                  "insp-t2": "base",
                  "insp-t3": "base",
                  "t1-pkg": "relax",
                  "t2-pkg": "relax",
