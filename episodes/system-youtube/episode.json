    {
      "id": "03",
      "title": "Adaptive streaming",
      "question": "How does playback start fast and survive a bad network?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. How does playback start quickly anywhere in the world, and keep going when the network gets worse? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Start fast, and <em>survive</em> a bad network?"
          }
        },
        {
          "type": "graph",
          "say": "When you press play, the player asks the video API for metadata, including the manifest's URL on a CDN. It downloads the manifest from the nearest edge, and the manifest lists every quality level. Popular segments are already cached at the edge; a miss is fetched from processed storage once, and then cached. The player measures its bandwidth and picks a quality: on a fast connection, ten eighty p segments. Enter a tunnel, bandwidth drops, and the next segment comes from the four eighty p stream instead, without stopping playback. When the network recovers, it steps back up.",
          "props": {
            "title": "Edge-cached, <em>adaptive</em>",
            "nodes": [
              {
                "id": "player",
                "label": "Player",
                "x": 180,
                "y": 470,
                "w": 180,
                "h": 70
              },
              {
                "id": "api",
                "label": "Video API",
                "x": 560,
                "y": 290,
                "w": 220,
                "h": 64
              },
              {
                "id": "cdn",
                "label": "CDN edge",
                "x": 560,
                "y": 620,
                "w": 220,
                "h": 70
              },
              {
                "id": "origin",
                "label": "Processed\nstorage",
                "x": 990,
                "y": 620,
                "w": 220,
                "h": 90
              }
            ],
            "edges": [
              {
                "from": "player",
                "to": "api",
                "w": "metadata"
              },
              {
                "from": "player",
                "to": "cdn"
              },
              {
                "from": "cdn",
                "to": "origin",
                "w": "miss"
              }
            ],
            "panels": [
              {
                "key": "bw",
                "label": "Bandwidth",
                "type": "list",
                "rows": 1,
                "initial": []
              },
              {
                "key": "seg",
                "label": "Segments fetched",
                "type": "list",
                "rows": 3,
                "initial": []
              }
            ],
            "steps": [
              {
                "at": "press",
                "nodes": {
                  "player": "active"
                },
                "edges": {
                  "player-api": "relax"
                },
                "note": "Metadata, including the manifest URL"
              },
              {
                "at": "nearest",
                "nodes": {
                  "player": "base",
                  "cdn": "active"
                },
                "edges": {
                  "player-api": "base",
                  "player-cdn": "relax"
                },
                "panels": {
                  "seg": [
                    "manifest"
                  ]
                },
                "note": "Manifest from the nearest edge"
              },
              {
                "at": "miss",
                "nodes": {
                  "origin": "active"
                },
                "edges": {
                  "cdn-origin": "relax"
                },
                "note": "Edge miss → origin once, then cached"
              },
              {
                "at": "measures",
                "nodes": {
                  "origin": "base"
                },
                "edges": {
                  "cdn-origin": "base"
                },
                "panels": {
                  "bw": [
                    "8 Mbps"
                  ],
                  "seg": [
                    "manifest",
                    "seg 1 · 1080p",
                    "seg 2 · 1080p"
                  ]
                },
                "note": "Fast link → 1080p segments"
              },
              {
                "at": "tunnel",
                "nodes": {
                  "cdn": "queued"
                },
                "panels": {
                  "bw": [
                    "0.9 Mbps"
                  ],
                  "seg": [
                    "manifest",
                    "seg 1 · 1080p",
                    "seg 2 · 1080p",
                    "seg 3 · 480p"
                  ]
                },
                "note": "Bandwidth drops → next segment at 480p"
              },
              {
