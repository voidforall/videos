                "x": 1250,
                "y": 470,
                "w": 220,
                "h": 90
              },
              {
                "id": "store",
                "label": "Processed storage",
                "x": 1620,
                "y": 330,
                "w": 290,
                "h": 64
              },
              {
                "id": "meta",
                "label": "Metadata: READY",
                "x": 1620,
                "y": 610,
