    {
      "id": "02",
      "title": "The multi-level feedback queue",
      "question": "How can a scheduler favour short jobs without knowing how long any job will run?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. Shortest job first needs to know how long each job will run, and the OS never knows. So how can a scheduler still favour short, interactive jobs? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Favour short jobs, <em>without knowing</em> job lengths?"
          }
        },
        {
          "type": "graph",
          "say": "A multi level feedback queue keeps several queues, by priority. A higher queue always runs first, and jobs in the same queue take turns. Every new job starts at the top, as if it were short. Job A is CPU bound. It uses up its time allotment at the top, so it's demoted, and demoted again, until it sinks to the bottom. Job B is interactive. It runs briefly, then waits for input, so it stays at the top, and responds quickly. Short jobs finish before they sink, so this approximates shortest job first, without knowing any lengths.",
          "props": {
            "title": "Learn from <em>behaviour</em>",
            "nodes": [
              {
                "id": "q2",
                "label": "Q2 · high",
                "x": 260,
                "y": 300,
                "w": 260,
                "h": 80
              },
