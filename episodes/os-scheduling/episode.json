    {
      "id": "01",
      "title": "Turnaround and response",
      "question": "A 100-second job arrives just before two 10-second jobs. What's the average turnaround under FIFO, and under SJF?",
      "scenes": [
        {
          "type": "question",
          "say": "CPU scheduling, question one. A 100 second job, A, arrives just before two 10 second jobs, B and C. What's the average turnaround time under first in, first out? And under shortest job first? Pause and work it out.",
          "pauseAfter": 4,
          "props": {
            "question": "A 100 s job, then two 10 s jobs. Average <em>turnaround</em>: FIFO vs SJF?"
          }
        },
        {
          "type": "graph",
          "say": "Turnaround time is when a job finishes, minus when it arrived. First in, first out runs A first. B waits behind it, and finishes at 110 seconds, C at 120. The average turnaround is 110 seconds. That's the convoy effect: short jobs stuck behind a long one. Shortest job first runs B and C first. They finish at 10 and 20, and A at 120, so the average is 50 seconds. When all jobs arrive together, that's optimal.",
          "props": {
            "title": "The <em>convoy</em> effect",
            "nodes": [
              {
                "id": "fifo",
                "label": "FIFO",
                "x": 190,
