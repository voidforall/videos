                "body": "What an interactive user feels.",
                "code": "T_first_run − T_arrival"
              },
              {
                "at": "Round",
                "label": "Round robin",
                "title": "Take turns, one slice each",
                "body": "Great response, near-worst turnaround.",
                "code": "3 × 5 s jobs, 1 s slices: 1 s vs 14 s"
              },
              {
                "at": "length",
                "label": "Time slice",
                "title": "A trade-off",
                "body": "Shorter: snappier, but more switches.",
                "code": "amortize the switch"
              }
            ]
          }
        }
