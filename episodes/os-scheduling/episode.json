            ],
            "edges": [],
            "panels": [],
            "steps": [
              {
                "at": "priority",
                "nodes": {
                  "q2": "active",
                  "q1": "base",
                  "q0": "base"
                },
                "note": "Queues, by priority"
              },
              {
                "at": "first",
                "note": "Rule 1: a higher queue always runs first"
              },
              {
                "at": "turns",
                "note": "Rule 2: same queue → round robin"
              },
              {
                "at": "top",
                "show": [
                  "A"
                ],
                "nodes": {
                  "A": "queued"
                },
                "note": "Rule 3: new jobs start at the top"
              },
              {
                "at": "allotment",
                "nodes": {
                  "A": "active"
                },
                "note": "A uses up its allotment at this level…"
              },
              {
                "at": "demoted",
                "move": {
                  "A": [
                    760,
                    450
                  ]
                },
                "nodes": {
                  "q2": "base",
                  "q1": "active"
                },
                "note": "Rule 4: …so it's demoted"
              },
