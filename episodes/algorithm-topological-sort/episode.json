          "type": "compare",
          "say": "Kahn's algorithm detects a cycle by counting: the output is shorter than the number of vertices. The DFS version tracks a visiting state, and an edge back to a vertex still on the call stack is a back edge, which is a cycle.",
          "props": {
            "title": "Two ways to <em>catch it</em>",
            "left": {
              "at": "counting",
              "label": "Kahn's (BFS)",
              "title": "Count the output",
              "code": "if ((int)order.size() != n)\n    return {};  // cycle",
              "body": "Leftover vertices are on or behind a cycle."
            },
            "right": {
              "at": "visiting",
              "label": "DFS",
              "title": "Find a back edge",
              "code": "state[u] = VISITING;\nfor (int v : adj[u])\n    if (state[v] == VISITING)\n        return false;  // cycle",
