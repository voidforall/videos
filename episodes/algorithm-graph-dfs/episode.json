            "code": "int dfs(const vector<vector<int>>& g, vector<vector<int>>& memo, int r, int c) {\n    if (memo[r][c]) return memo[r][c];            // computed already\n    static const int dr[] = {1, -1, 0, 0}, dc[] = {0, 0, 1, -1};\n    int best = 1;\n    for (int k = 0; k < 4; ++k) {\n        int nr = r + dr[k], nc = c + dc[k];\n        if (nr >= 0 && nr < (int)g.size() && nc >= 0 && nc < (int)g[0].size()\n            && g[nr][nc] > g[r][c])               // edges only go uphill\n            best = max(best, 1 + dfs(g, memo, nr, nc));\n    }\n    return memo[r][c] = best;\n}",
