        {
          "type": "points",
          "say": "So, for an edge from u to v: if v is entered but not exited, it's a back edge, and the graph has a cycle. If v is finished, and was entered after u, it's a forward edge. If v is finished, and was entered before u, it's a cross edge. Two more uses. u is an ancestor of v exactly when u's interval contains v's. And sorting by exit time, latest first, gives a topological order of a DAG.",
          "props": {
            "title": "Edge u → v, <em>by v's state</em>",
            "items": [
              {
                "at": "cycle",
                "label": "Back edge",
                "title": "v entered, not exited",
                "body": "v is on the current path: a cycle.",
                "code": "in[v] set, out[v] not"
              },
              {
                "at": "forward",
                "label": "Forward edge",
                "title": "v finished, entered after u",
                "body": "A shortcut to a descendant.",
                "code": "in[u] < in[v]"
              },
              {
                "at": "cross",
                "label": "Cross edge",
                "title": "v finished, entered before u",
                "body": "Into another, finished branch.",
                "code": "in[v] < in[u]"
              },
              {
                "at": "topological",
                "label": "Uses",
                "title": "Ancestors and topo order",
                "body": "Nested intervals; reverse exit order.",
                "code": "sort by out[] descending"
              }
            ]
          }
        }
      ]
