                "add": [
                  {
                    "from": "3",
                    "to": "0"
                  }
                ],
                "note": "Add 3 → 0, run again"
              },
              {
                "at": "again",
                "nodes": {
                  "0": "queued",
                  "1": "queued",
                  "3": "queued"
                },
                "edges": {
                  "0-1": "tree",
                  "1-3": "tree"
                },
                "note": "In progress: 0, 1, 3"
              },
              {
                "at": "reaches",
                "nodes": {
                  "0": "active"
                },
                "edges": {
                  "3-0": "relax"
                },
                "note": "3 → 0: 0 is in progress"
              },
              {
                "at": "closes",
                "note": "Cycle: 0 → 1 → 3 → 0"
              }
            ]
          }
        },
        {
          "type": "code",
          "say": "In code, state one means in progress. Mark it on entry. Reaching a node in state one is a back edge: return true. Recurse only into unvisited nodes, and skip finished ones. Mark two on the way out. And start a search from every unvisited node, so disconnected parts are covered. In an undirected graph, the rule is simpler: a visited neighbor that isn't your parent closes a cycle.",
          "props": {
            "title": "Three <em>states</em>",
            "file": "cycle.cpp",
            "tag": "C++",
            "lang": "cpp",
            "size": 20,
            "width": 1250,
            "code": "// state: 0 = unvisited, 1 = in progress (on the path), 2 = done\nbool hasCycle(int u, const vector<vector<int>>& adj, vector<int>& state) {\n    state[u] = 1;\n    for (int v : adj[u]) {\n        if (state[v] == 1) return true;           // back edge: a cycle\n        if (state[v] == 0 && hasCycle(v, adj, state)) return true;\n    }                                             // state 2: finished, skip\n    state[u] = 2;\n    return false;\n}\nbool anyCycle(const vector<vector<int>>& adj) {\n    vector<int> state(adj.size(), 0);\n    for (int u = 0; u < (int)adj.size(); ++u)     // every component\n        if (state[u] == 0 && hasCycle(u, adj, state)) return true;\n    return false;\n}",
            "highlights": [
              {
                "at": "entry",
                "lines": "3",
                "note": "In progress on entry"
              },
              {
                "at": "true",
                "lines": "5",
                "note": "Back edge: a cycle"
              },
              {
                "at": "Recurse",
                "lines": "6",
                "note": "Recurse into unvisited only"
              },
              {
                "at": "out",
                "lines": "8",
                "note": "Done on exit"
              },
              {
                "at": "every",
                "lines": "13-14",
                "note": "Every component"
              }
            ]
          }
        }
      ]
