    {
      "id": "02",
      "title": "Finding a cycle",
      "question": "Why isn't \"already visited\" enough to detect a cycle in a directed graph?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. In a directed graph, why isn't already visited enough to detect a cycle? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Why isn't <em>visited</em> enough to find a cycle?"
          }
        },
        {
          "type": "graph",
          "say": "Here's a diamond: zero points to one and two, and both point to three. DFS goes zero, one, three. Three finishes, then one. Now, from two, the edge to three hits a visited node. But there's no cycle: three is finished, so this path just joins a branch that's already done. That's why you need three states: unvisited, in progress, and done. Only reaching a node that's in progress, still on the current path, is a cycle. Add an edge from three back to zero, and run it again: zero, one, three, and now three's edge reaches zero while zero is in progress. That edge closes a cycle.",
          "props": {
            "title": "Visited is not <em>in progress</em>",
            "nodes": [
              {
                "id": "0",
