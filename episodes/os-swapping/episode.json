        {
          "type": "compare",
          "say": "Most faults never touch the disk. The first touch of fresh memory just maps a zeroed frame. A page already in the page cache, like a shared library another process loaded, just gets mapped. These minor faults cost around a microsecond or a few: a Linux VM measured three and a half per first touch, including zeroing the page. A major fault waits for storage: around a hundred microseconds on an SSD, and ten milliseconds on a spinning disk.",
          "props": {
            "title": "Minor or <em>major</em>",
            "left": {
              "at": "minor",
              "label": "Minor fault",
              "title": "No I/O",
              "tone": "good",
              "body": "First touch (zero-fill) or a page already cached. ~1–4 µs."
            },
            "right": {
              "at": "major",
              "label": "Major fault",
              "title": "Waits for storage",
              "body": "Swap-in or an uncached file page. ~100 µs SSD, ~10 ms HDD."
            },
            "verdict": {
              "at": "spinning",
              "text": "Major faults are what make a machine feel frozen.",
              "code": "/usr/bin/time -v · perf stat -e major-faults"
            }
          }
        }
      ]
