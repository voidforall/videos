      "id": "02",
      "title": "Visiting every node",
      "question": "How do you find the cheapest path that visits every node exactly once?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. How do you find the cheapest path that visits every node exactly once? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "The cheapest path through <em>every node</em>?"
