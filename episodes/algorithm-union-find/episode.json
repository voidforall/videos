    {
      "id": "03",
      "title": "Code and patterns",
      "question": "Write union-find with both optimizations, and name problems it solves.",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. Write union-find with both optimizations, and name the problems it solves. Pause and sketch it out.",
          "pauseAfter": 4,
          "props": {
            "question": "Write union-find with both optimizations, and <em>name its problems</em>."
          }
        },
        {
          "type": "code",
          "say": "The constructor makes every element its own parent. Find compresses as it returns: each node is re-pointed at the root. Unite finds both roots and returns false if they already match, which is how you detect a cycle. Otherwise the higher rank becomes the parent, and equal ranks grow by one.",
          "props": {
            "title": "Union-find, <em>in code</em>",
            "file": "dsu.cpp",
            "tag": "O(α(n))",
            "size": 21,
            "width": 1060,
            "code": "class DSU {\npublic:\n    DSU(int n) : parent(n), rank(n, 0) {\n        iota(parent.begin(), parent.end(), 0);\n    }\n    int find(int x) {\n        return parent[x] == x ? x : parent[x] = find(parent[x]);\n    }\n    bool unite(int x, int y) {\n        int rx = find(x), ry = find(y);\n        if (rx == ry) return false;  // already connected\n        if (rank[rx] < rank[ry]) swap(rx, ry);\n        parent[ry] = rx;\n        if (rank[rx] == rank[ry]) rank[rx]++;\n        return true;\n    }\nprivate:\n    vector<int> parent, rank;\n};",
            "highlights": [
              {
                "at": "constructor",
                "lines": "3-4",
                "note": "Everyone starts as their own root"
              },
              {
                "at": "compresses",
                "lines": "7",
                "note": "Path compression on the way back"
              },
              {
                "at": "false",
                "lines": "10-11",
                "note": "Same root → already connected (cycle)"
              },
              {
                "at": "higher",
                "lines": "12-13",
                "note": "Union by rank: higher rank is the parent"
              },
              {
                "at": "equal",
                "lines": "14",
                "note": "Equal ranks: the new root grows"
              }
            ]
          }
        },
