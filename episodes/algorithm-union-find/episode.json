          "props": {
            "question": "How are sets represented, and what do <em>find</em> and <em>union</em> do?"
          }
        },
        {
          "type": "points",
          "say": "Each set is a tree of parent pointers, and the root names the set. Find follows parents up to the root. Union finds both roots and points one root at the other. Two elements are connected exactly when they share a root.",
          "props": {
            "title": "A forest of <em>parent pointers</em>",
            "items": [
              {
                "at": "tree",
                "label": "Representation",
                "title": "Root names the set",
                "body": "parent[x] == x means x is a root.",
                "code": "vector<int> parent"
              },
              {
                "at": "follows",
                "label": "find(x)",
                "title": "Climb to the root",
                "body": "Follow parent pointers upward.",
                "code": "while (p[x] != x) x = p[x]"
              },
              {
                "at": "both",
                "label": "unite(x, y)",
                "title": "Link the roots",
                "body": "Point one root at the other.",
                "code": "parent[ry] = rx"
              },
              {
                "at": "connected",
                "label": "connected(x, y)",
                "title": "Same root?",
                "body": "One find each, then compare.",
                "code": "find(x) == find(y)"
              }
            ]
          }
        },
