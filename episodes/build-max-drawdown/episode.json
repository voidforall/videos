    {
      "id": "02",
      "title": "Why CAS is wrong",
      "question": "Many threads feed updates. Why doesn't a CAS max, like for max price, work for drawdown?",
      "scenes": [
        {
          "type": "question",
          "say": "Problem two. Many threads feed updates. For a running max price, a compare-and-swap loop works. Why doesn't the same trick work for max drawdown? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "A CAS max works for <em>max price</em>. Why not for drawdown?"
          }
        },
        {
          "type": "compare",
          "say": "Max price is commutative: apply the updates in any order, and you get the same answer. Drawdown isn't. Start with a high of one hundred. If ninety arrives before one ten, the drawdown is ten. If one ten arrives first, the high becomes one ten, and ninety is now twenty below it. Same events, different answer. Concurrent compare-and-swap reorders events, so it silently computes the wrong number.",
          "props": {
            "title": "Same events, <em>different answer</em>",
            "lang": "cpp",
            "left": {
              "at": "before",
              "label": "90, then 110",
              "title": "max dd = 10",
              "tone": "good",
              "code": "high 100: 90  → dd 10\nhigh 110: 110 → dd 0\nmax_dd = 10"
            },
            "right": {
              "at": "first",
              "label": "110, then 90",
              "title": "max dd = 20",
              "tone": "bad",
              "code": "high 110: 110 → dd 0\nhigh 110: 90  → dd 20\nmax_dd = 20"
            },
            "verdict": {
              "at": "silently",
              "text": "Path-dependent: each ticker needs one total order.",
              "code": "order matters"
            }
          }
        }
      ]
    },
