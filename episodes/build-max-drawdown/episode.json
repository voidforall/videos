    {
      "id": "04",
      "title": "Pitfalls and follow-ups",
      "question": "What breaks this design, and how would you extend it?",
      "scenes": [
        {
          "type": "question",
          "say": "Problem four. What can still break this design, and how would you extend it? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "What breaks it, and how would you <em>extend</em> it?"
          }
        },
        {
          "type": "points",
          "say": "Four things to mention. Reject NaN at the boundary: a NaN price never raises the high, but poisons the drawdown. The design only matches the reference if each ticker's feed is in order on the wire, so say that assumption out loud. A sixteen-byte atomic is lock-free only with a double-width compare-and-swap; otherwise publish through a seqlock. And for a trailing window, the writer keeps a monotonic deque of prices, at no extra concurrency cost.",
          "props": {
            "title": "Pitfalls and <em>follow-ups</em>",
            "items": [
              {
                "at": "NaN",
                "label": "Input",
                "title": "Reject NaN",
                "body": "NaN never raises the high, but poisons dd.",
                "code": "isnan → drop"
              },
              {
                "at": "assumption",
                "label": "Ordering",
                "title": "In-order feed",
                "body": "Per-ticker wire order is assumed.",
                "code": "else: reorder buffer"
              },
              {
                "at": "atomic",
                "label": "Publish",
                "title": "16-byte atomic",
                "body": "Needs CMPXCHG16B; else a seqlock.",
                "code": "-mcx16"
              },
              {
                "at": "window",
                "label": "Windowed",
                "title": "Trailing W",
                "body": "Monotonic deque in the writer.",
                "code": "deque<(t, p)>"
              }
            ]
          }
        },
