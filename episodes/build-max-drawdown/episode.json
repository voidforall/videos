    {
      "id": "01",
      "title": "The one-pass update",
      "question": "Track a ticker's max drawdown over a stream of prices.",
      "scenes": [
        {
          "type": "question",
          "say": "Max drawdown, problem one. Prices stream in for a ticker. Track its maximum drawdown: the largest drop from a peak to a later trough. Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Track a ticker's <em>max drawdown</em> over a price stream."
          }
        },
        {
          "type": "array",
          "say": "Walk the prices once, keeping two numbers: the running high, and the largest drop from it. One hundred starts as the high. Then ninety: ten below the high, so the max drawdown is ten. One ten sets a new high, and the current drop resets to zero. Ninety-five drops fifteen from it, so the max becomes fifteen. One twenty is another new high. And one hundred falls twenty from it: the max drawdown is twenty, from one twenty down to one hundred.",
          "props": {
            "title": "Running high, <em>largest drop</em>",
            "values": [
              100,
              90,
              110,
              95,
              120,
              100
            ],
            "stateLabel": "high · current drop",
            "resultLabel": "Max drawdown",
            "pointers": {
              "l": "peak",
              "r": "price"
            },
            "steps": [
              {
                "at": "starts",
                "l": 0,
                "r": 0,
                "state": "100 · 0",
                "note": "First price: the high",
                "result": "0"
              },
              {
                "at": "Then",
                "l": 0,
                "r": 1,
                "state": "100 · 10",
                "note": "90 is 10 below the high",
                "result": "10"
              },
              {
                "at": "sets",
                "l": 2,
                "r": 2,
                "state": "110 · 0",
                "note": "New high: the drop resets"
              },
              {
                "at": "drops",
                "l": 2,
                "r": 3,
                "state": "110 · 15",
                "note": "95 is 15 below 110",
                "result": "15"
              },
              {
                "at": "another",
                "l": 4,
                "r": 4,
                "state": "120 · 0",
                "note": "Another new high"
              },
              {
                "at": "falls",
                "l": 4,
                "r": 5,
                "mark": "ok",
                "state": "120 · 20",
                "note": "Peak 120 → trough 100",
                "result": "20"
              }
            ]
          }
        },
        {
          "type": "code",
          "say": "So the whole update is two lines: raise the high, then compare the drop from it with the best so far. Constant time and constant space per ticker.",
          "props": {
            "title": "Two lines, <em>O(1)</em>",
            "file": "drawdown.cpp",
            "tag": "per ticker",
            "lang": "cpp",
            "size": 26,
