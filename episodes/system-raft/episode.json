    {
      "id": "02",
      "title": "Log replication",
      "question": "When is a Raft log entry committed, and what keeps committed entries safe?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. When is a log entry committed in Raft, and what keeps committed entries safe across leader changes? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "When is an entry <em>committed</em>, and what keeps it safe?"
          }
        },
        {
          "type": "graph",
          "say": "A client sends set x to five to the leader, C. The leader appends it to its own log at index four, but it is not committed yet. It replicates the entry to the followers with AppendEntries. B and D store it and acknowledge. Counting itself, three of five servers now hold the entry: a majority, so it is committed. The leader applies it to its state machine, and replies to the client. The next heartbeat carries the new commit index, so the followers apply it too, and slow E catches up.",
          "props": {
            "title": "Committed = on a <em>majority</em>",
            "nodes": [
              {
                "id": "A",
                "x": 680,
                "y": 280
              },
              {
                "id": "B",
                "x": 861,
                "y": 411
              },
              {
                "id": "C",
                "x": 792,
                "y": 624
              },
              {
                "id": "D",
                "x": 568,
                "y": 624
              },
              {
                "id": "E",
                "x": 499,
                "y": 411
              },
              {
                "id": "client",
                "label": "Client",
                "x": 1060,
                "y": 624,
                "w": 180,
                "h": 64
              }
            ],
            "edges": [],
            "panels": [
              {
                "key": "log",
                "label": "Last log index",
                "type": "table",
                "columns": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E"
                ],
                "initial": {
                  "A": "3",
                  "B": "3",
                  "C": "3",
                  "D": "3",
                  "E": "3"
                }
              },
              {
                "key": "commit",
                "label": "Committed",
                "type": "list",
                "initial": [
                  "1–3"
                ]
              }
            ],
            "steps": [
              {
                "at": "sends",
                "add": [
                  {
                    "from": "client",
                    "to": "C",
                    "w": "x = 5"
                  }
                ],
                "nodes": {
                  "A": "dim",
                  "C": "active"
                },
                "edges": {
                  "client-C": "relax"
                },
                "note": "Client → leader C: set x = 5"
              },
              {
                "at": "appends",
                "edges": {
                  "client-C": "base"
                },
                "panels": {
                  "log": {
                    "C": "4"
                  }
                },
                "note": "Leader appends at index 4: not committed yet"
              },
              {
                "at": "replicates",
                "add": [
                  {
                    "from": "C",
                    "to": "B"
                  },
                  {
                    "from": "C",
                    "to": "D"
                  },
                  {
                    "from": "C",
                    "to": "E"
                  }
                ],
                "edges": {
                  "C-B": "relax",
                  "C-D": "relax",
                  "C-E": "relax"
                },
                "note": "AppendEntries(index 4) to the followers"
              },
              {
                "at": "acknowledge",
                "nodes": {
                  "B": "done",
                  "D": "done"
                },
                "panels": {
                  "log": {
                    "B": "4",
                    "D": "4"
                  }
                },
                "note": "B and D store it and ack; E is slow"
              },
              {
                "at": "majority",
                "edges": {
                  "C-B": "tree",
                  "C-D": "tree"
                },
                "panels": {
                  "commit": [
                    "1–3",
                    "4: x = 5"
                  ]
                },
                "note": "3 of 5 hold index 4 → committed"
              },
              {
                "at": "replies",
                "add": [
                  {
                    "from": "C",
                    "to": "client",
                    "w": "ok"
                  }
                ],
                "edges": {
                  "C-client": "relax"
                },
                "note": "Apply to the state machine, reply ok"
              },
              {
                "at": "heartbeat",
                "nodes": {
                  "B": "base",
                  "D": "base"
                },
                "edges": {
                  "C-client": "base",
                  "C-B": "base",
                  "C-D": "base",
                  "C-E": "tree"
                },
                "panels": {
                  "log": {
                    "E": "4"
                  }
                },
                "note": "Heartbeat carries commitIndex 4: all apply"
              }
            ]
          }
        },
        {
          "type": "points",
          "say": "Three rules keep committed entries safe. Voters reject a candidate whose log is behind their own, so any new leader already holds every committed entry. If two logs share an entry with the same index and term, they are identical up to that point. And data only flows from leader to follower: the leader overwrites a follower's conflicting entries, never the other way round.",
          "props": {
            "title": "Three <em>safety</em> rules",
            "items": [
              {
                "at": "reject",
                "label": "Election restriction",
                "title": "Stale logs lose",
                "body": "Voters refuse a candidate whose log is behind theirs.",
                "code": "new leader has all commits"
              },
              {
                "at": "identical",
                "label": "Log matching",
                "title": "Same index + term",
                "body": "…means identical logs up to that entry.",
                "code": "(index, term)"
              },
              {
                "at": "flows",
                "label": "Leader only",
                "title": "One direction",
                "body": "The leader overwrites conflicting follower entries.",
                "code": "leader → follower"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "03",
      "title": "Network partitions",
      "question": "A five-node cluster splits two and three. What happens to writes on each side?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. A five-node cluster is split by the network into two servers and three servers. What happens to writes on each side, and when it heals? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "The cluster splits <em>2 | 3</em>. What happens to writes on each side?"
          }
        },
        {
          "type": "graph",
          "say": "A is the leader when the network splits the cluster: A and B on one side, C, D and E on the other. A still believes it leads, but it can reach only two of five servers, so a write it receives stalls: it can never commit. On the other side, C times out, wins votes from D and E in term three, and becomes leader. With three of five, that side keeps committing writes. When the partition heals, A sees the higher term and steps down. A and B roll back their uncommitted entry, and copy the new leader's log.",
          "props": {
            "title": "Only the <em>majority</em> side moves",
