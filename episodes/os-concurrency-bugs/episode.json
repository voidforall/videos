                "at": "cycle",
                "text": "Deadlock: break the cycle with a global lock order.",
                "code": "std::scoped_lock"
              },
              {
                "at": "inherit",
                "text": "Priority inversion: the holder inherits priority.",
                "code": "PTHREAD_PRIO_INHERIT"
              }
            ]
          }
