        {
          "type": "points",
          "say": "The other three can be broken too, at a cost. Take all your locks at once, under one big lock, and hold and wait is gone, but so is concurrency. Use try lock, and if the next lock is busy, release what you hold, and retry, with a random delay, or two threads can retry in lockstep forever: that's livelock. Lock free structures remove mutual exclusion itself. And databases detect cycles in a waits for graph, and abort one victim transaction.",
          "props": {
            "title": "Breaking the <em>others</em>",
            "items": [
              {
                "at": "once",
                "label": "Hold and wait",
                "title": "All locks at once",
                "body": "Under one global lock: concurrency suffers.",
                "code": "coarse locking"
              },
              {
                "at": "release",
                "label": "No preemption",
                "title": "trylock, back off",
                "body": "Add random delays to avoid livelock.",
                "code": "pthread_mutex_trylock"
              },
              {
                "at": "remove",
                "label": "Mutual exclusion",
                "title": "Go lock-free",
                "body": "No locks to deadlock on; harder code.",
                "code": "CAS"
              },
              {
                "at": "detect",
                "label": "Detect, recover",
                "title": "Find the cycle",
                "body": "Databases abort a victim transaction.",
                "code": "waits-for graph"
              }
            ]
          }
        }
