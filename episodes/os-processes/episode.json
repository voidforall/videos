        {
          "type": "points",
          "say": "A zombie holds no memory and no CPU, just a process table slot, and its P I D. You can't kill it: it's already dead. The danger is a parent that forks, and never waits: zombies pile up until P I Ds run out. Fix the parent: call wait pid, or handle SIGCHLD and reap in a loop, or ignore SIGCHLD, so the kernel reaps automatically. If the parent dies first, its children are orphans: init, process one, adopts and reaps them.",
          "props": {
            "title": "Getting rid of <em>zombies</em>",
            "items": [
              {
                "at": "slot",
                "label": "What's left",
                "title": "A PID and an exit status",
                "body": "No memory, no CPU. kill can't remove it.",
                "code": "ps: STAT Z"
              },
              {
                "at": "never",
                "label": "The danger",
                "title": "A parent that never waits",
                "body": "Zombies pile up until PIDs run out.",
                "code": "pid_max"
              },
              {
                "at": "Fix",
                "label": "The fix",
                "title": "Reap in the parent",
                "body": "waitpid; reap in a SIGCHLD handler; or ignore SIGCHLD.",
                "code": "waitpid(-1, &s, WNOHANG)"
              },
              {
                "at": "orphans",
                "label": "Orphans",
                "title": "Parent died first",
                "body": "init (PID 1) adopts and reaps them.",
                "code": "or a subreaper"
              }
            ]
          }
        }
