    {
      "id": "02",
      "title": "Unbounded knapsack",
      "question": "How does the code for unbounded knapsack differ from 0/1?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. If every item can be used any number of times, what changes in the code? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Unbounded: what <em>changes</em> in the code?"
          }
        },
        {
          "type": "compare",
          "say": "One thing: the direction. In the backward loop, each read sees the state before this item, so it's used at most once. In the forward loop, each read may already include this item, so it can be used again and again. Take three items: weight one, value fifteen; weight three, value twenty; weight four, value thirty, with capacity four. Zero-one gives thirty-five: the first and the second. Unbounded gives sixty: the first item, four times.",
          "props": {
            "title": "Flip the <em>loop</em>",
            "left": {
              "at": "backward",
              "label": "0/1",
              "title": "Backward: at most once",
              "code": "for (w = W; w >= wt; --w)",
              "body": "Reads come from before this item. Example: 35."
            },
            "right": {
              "at": "forward",
              "label": "Unbounded",
              "title": "Forward: any number",
              "tone": "good",
              "code": "for (w = wt; w <= W; ++w)",
              "body": "Reads may include this item. Example: 60."
            },
            "verdict": {
              "at": "Take",
              "text": "Items (1, 15), (3, 20), (4, 30), W = 4: 0/1 → 35, unbounded → 60.",
              "code": "0/1: items 1 + 2 · unbounded: item 1 ×4"
            }
          }
        },
        {
          "type": "code",
          "say": "Coin change is unbounded knapsack: coins are items you can reuse, and you minimize the count. d p of a is the fewest coins that make a. The forward loop lets coin c appear many times. Start every cell at a large value, but not int max: adding one would overflow. Half of int max is safe.",
          "props": {
            "title": "Coin change",
            "file": "coin_change.cpp",
            "tag": "C++",
            "lang": "cpp",
            "size": 22,
            "width": 1200,
            "code": "int coinChange(const vector<int>& coins, int amount) {\n    const int INF = INT_MAX / 2;            // INF + 1 must not overflow\n    vector<int> dp(amount + 1, INF);        // dp[a]: fewest coins for a\n    dp[0] = 0;\n    for (int c : coins)\n        for (int a = c; a <= amount; ++a)   // forward: coin c can repeat\n            dp[a] = min(dp[a], dp[a - c] + 1);\n    return dp[amount] >= INF ? -1 : dp[amount];\n}",
            "highlights": [
              {
                "at": "fewest",
                "lines": "3-4",
                "note": "dp[a]: fewest coins for amount a"
              },
              {
                "at": "forward",
                "lines": "6-7",
                "note": "Forward: coins repeat"
              },
              {
                "at": "overflow",
                "lines": "2",
                "note": "INF + 1 must not overflow"
              },
              {
                "at": "safe",
                "lines": "8",
                "note": "Unreachable stays INF"
              }
            ]
          }
        }
      ]
    },
