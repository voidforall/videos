        {
          "type": "points",
          "say": "Real TLBs are small: around sixty four entries in the first level, and one to two thousand in the second. On a miss, x86 and ARM walk the page table in hardware. MIPS left it to software: a trap to the kernel, which refilled the TLB itself, and could use any table format it liked. Either way, a miss costs tens of cycles when the walk hits in cache, and hundreds when it goes all the way to main memory.",
          "props": {
            "title": "Small, and <em>usually enough</em>",
            "items": [
              {
                "at": "small",
                "label": "Size",
                "title": "Small",
                "body": "~64 first-level entries; ~1–2K second-level.",
                "code": "per core"
              },
              {
                "at": "hardware",
                "label": "x86 · ARM",
                "title": "Hardware page walk",
                "body": "The MMU walks the table itself.",
                "code": "no kernel entry"
              },
              {
                "at": "software",
                "label": "MIPS",
                "title": "Software refill",
                "body": "A trap; the kernel fills the TLB.",
                "code": "any table format"
              },
              {
                "at": "cycles",
                "label": "Miss cost",
                "title": "Tens to hundreds of cycles",
                "body": "Cached walk vs. a trip to DRAM.",
                "code": "perf: dTLB-load-misses"
              }
            ]
          }
        }
      ]
