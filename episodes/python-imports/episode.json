    {
      "id": "01",
      "title": "What import does",
      "question": "What actually happens when Python runs import foo, the first time and the second?",
      "scenes": [
        {
          "type": "question",
          "say": "Imports, question one. What actually happens when Python runs import foo, the first time, and the second time? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "What happens on <em>import foo</em>, the first time and the second?"
          }
        },
        {
          "type": "graph",
          "say": "Every import starts at a cache. Python first checks sys modules for the name. On a miss, it creates an empty module object, and inserts it into the cache before running anything. Then finders locate the source: built-ins, frozen modules, then directories on sys path. The loader compiles it, caching bytecode, and executes it top to bottom, which fills in the module. A second import of the same name is a cache hit, so module code runs once per process.",
          "props": {
            "title": "A cache, then a <em>loader</em>",
            "nodes": [
              {
                "id": "stmt",
                "label": "import foo",
                "x": 180,
                "y": 470,
                "w": 200,
                "h": 64
              },
              {
                "id": "cache",
                "label": "sys.modules",
                "x": 560,
                "y": 290,
                "w": 230,
                "h": 64
              },
              {
                "id": "find",
                "label": "finders · sys.path",
                "x": 560,
                "y": 470,
                "w": 290,
                "h": 64
              },
              {
                "id": "exec",
                "label": "execute foo.py",
                "x": 560,
                "y": 650,
                "w": 250,
                "h": 64
              },
              {
                "id": "mod",
                "label": "<module foo>",
                "x": 1000,
                "y": 470,
                "w": 230,
                "h": 64,
                "hidden": true
              }
            ],
            "edges": [
              {
                "from": "stmt",
                "to": "cache"
              },
              {
                "from": "stmt",
                "to": "find"
              },
              {
                "from": "find",
                "to": "exec"
              }
            ],
            "panels": [
              {
                "key": "mods",
                "label": "sys.modules",
                "type": "list",
                "rows": 1,
                "initial": [
                  "sys",
                  "builtins",
                  "…"
                ]
              }
            ],
            "steps": [
              {
                "at": "first",
                "nodes": {
                  "stmt": "active"
                },
                "edges": {
                  "stmt-cache": "relax"
                },
                "note": "1. Look up sys.modules['foo']"
              },
              {
                "at": "miss",
                "nodes": {
                  "stmt": "base",
                  "cache": "queued"
                },
                "edges": {
                  "stmt-cache": "base"
                },
                "note": "Miss"
              },
              {
                "at": "inserts",
                "show": [
                  "mod"
                ],
                "add": [
                  {
                    "from": "cache",
                    "to": "mod",
                    "w": "empty, cached first"
                  }
                ],
                "nodes": {
                  "mod": "queued"
                },
                "edges": {
                  "cache-mod": "relax"
                },
                "panels": {
                  "mods": [
                    "…",
                    "foo → <empty module>"
                  ]
                },
                "note": "2. Create an empty module and cache it — before running"
              },
              {
                "at": "finders",
                "nodes": {
                  "cache": "base",
                  "find": "active"
                },
                "edges": {
                  "cache-mod": "base",
                  "stmt-find": "relax"
                },
                "note": "3. Finders: built-in, frozen, then sys.path"
              },
              {
                "at": "executes",
                "add": [
                  {
                    "from": "exec",
                    "to": "mod"
                  }
                ],
                "nodes": {
                  "find": "base",
                  "exec": "active",
                  "mod": "done"
                },
                "edges": {
                  "stmt-find": "base",
                  "find-exec": "relax",
                  "exec-mod": "relax"
                },
                "panels": {
                  "mods": [
                    "…",
                    "foo → <module foo>"
                  ]
                },
                "note": "4. Compile (.pyc), run top-to-bottom, fill the module"
              },
              {
                "at": "second",
                "nodes": {
                  "exec": "base",
                  "cache": "done"
                },
                "edges": {
                  "find-exec": "base",
                  "exec-mod": "base",
                  "stmt-cache": "tree",
                  "cache-mod": "tree"
                },
                "note": "Next import: cache hit — the code runs once"
              }
            ]
          }
        }
      ]
