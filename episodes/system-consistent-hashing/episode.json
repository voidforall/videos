  "clips": [
    {
      "id": "01",
      "title": "Why not hash mod N?",
      "question": "Why does hash(key) mod N break down when you add a server?",
      "scenes": [
        {
          "type": "question",
          "say": "Consistent hashing, question one. Why does hash of key, mod N, break down when you add a server? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Why does <em>hash(key) % N</em> break when you add a server?"
          }
        },
        {
          "type": "compare",
          "say": "With four servers, each key goes to its hash mod four. Add a fifth server, and the same keys now go to their hash mod five. Four of these six keys land on a different server. In general, growing from N to N plus one servers moves about N out of N plus one keys. For a cache, that is almost a full flush.",
          "props": {
            "title": "Change N, <em>move almost everything</em>",
            "lang": "python",
            "left": {
              "at": "each",
              "label": "N = 4",
              "title": "hash % 4",
              "code": "keys = [10, 23, 36, 47, 58, 61]\n[k % 4 for k in keys]\n# → [2, 3, 0, 3, 2, 1]"
            },
            "right": {
              "at": "fifth",
              "label": "N = 5",
              "title": "hash % 5",
              "tone": "bad",
              "code": "[k % 5 for k in keys]\n# → [0, 3, 1, 2, 3, 1]\n# moved: 10, 36, 47, 58"
            },
            "verdict": {
              "at": "general",
              "text": "N → N+1 servers remaps about N/(N+1) of all keys.",
              "code": "4 → 5: ~80% move"
            }
          }
        },
        {
          "type": "statement",
          "say": "Consistent hashing fixes exactly this. Adding a server moves only the keys it takes over, about one in N plus one, and every other key stays where it is.",
          "props": {
            "text": "Add a server: only <em>~1/(N+1)</em> of keys move.",
            "at": "fixes",
            "sub": "Every other key stays where it is.",
            "subAt": "every"
          }
        }
      ]
    },
    {
      "id": "02",
      "title": "The hash ring",
      "question": "How does consistent hashing decide which server owns a key?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. How does consistent hashing decide which server owns a key, and what moves when servers come and go? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Which server <em>owns</em> a key, and what moves when servers come and go?"
          }
        },
        {
          "type": "ring",
          "say": "Hash every server and every key onto the same ring. To find a key's owner, walk clockwise from the key to the first server. Key three lands just before B, so B owns it. Key seven walks past zero, and wraps around to A. Now a new server, D, joins the ring. It takes over only the keys between B and D: here, just one key. Every other key stays put. Then server B leaves. Its three keys move on clockwise, to D, and again, nothing else moves.",
          "props": {
            "title": "Walk <em>clockwise</em> to the owner",
            "servers": [
