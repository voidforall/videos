        {
          "type": "compare",
          "say": "You can run the same recurrence two ways. Top-down: write the recursion, and cache each answer the first time you compute it. It's the easiest to get right, and it only visits states you need. Bottom-up: fill a table in order, with no recursion. No stack depth limit, and it's easier to shrink to a few variables. Same states, same complexity.",
          "props": {
            "title": "Memo, or <em>table</em>",
            "left": {
              "at": "Top-down",
              "label": "Top-down",
              "title": "Recursion + memo",
              "code": "if (memo[i]) return memo[i];",
              "body": "Easiest to write; visits only the states it needs."
            },
            "right": {
              "at": "Bottom-up",
              "label": "Bottom-up",
              "title": "Fill a table in order",
              "tone": "good",
              "code": "for (i = 0; i < n; ++i) dp[i] = …",
              "body": "No recursion depth; easy to shrink to O(1) space."
            },
            "verdict": {
              "at": "Same",
              "text": "Same states, same transitions, same complexity.",
              "code": "states × work per state"
            }
          }
        }
