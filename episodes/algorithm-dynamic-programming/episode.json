            "width": 1200,
            "code": "int maxCoins(vector<int> nums) {\n    nums.insert(nums.begin(), 1);           // virtual 1s at both ends\n    nums.push_back(1);\n    int n = nums.size();\n    // dp[i][j]: best for the balloons strictly between i and j\n    vector<vector<int>> dp(n, vector<int>(n, 0));\n    for (int len = 2; len < n; ++len)       // short intervals first\n        for (int i = 0; i + len < n; ++i) {\n            int j = i + len;\n            for (int k = i + 1; k < j; ++k)  // k: the LAST balloon to burst\n                dp[i][j] = max(dp[i][j],\n                    dp[i][k] + nums[i] * nums[k] * nums[j] + dp[k][j]);\n        }\n    return dp[0][n - 1];\n}",
