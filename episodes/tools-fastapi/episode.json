    {
      "id": "03",
      "title": "Dependencies and lifespan",
      "question": "How do you manage per-request resources and app-wide startup and shutdown?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. How do you give each request a database session that's always closed, and set up shared resources once, at startup? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "Per-request <em>sessions</em>, and app-wide <em>startup</em>?"
          }
        },
        {
          "type": "code",
          "say": "A dependency with yield is a small context manager. The code before yield is setup, the yielded value is injected, and the code after yield is teardown, which by default runs after the response is sent. For app-wide resources, pass a lifespan: an async context manager that runs startup before its yield, and shutdown after. It replaces the old on-event handlers, which are deprecated.",
          "props": {
            "title": "Setup, <em>yield</em>, teardown",
            "file": "app.py",
            "tag": "Depends · lifespan",
            "lang": "python",
            "size": 21,
            "width": 1150,
            "code": "async def get_db():\n    db = Session()\n    try:\n        yield db                      # injected into the endpoint\n    finally:\n        await db.close()              # runs after the response is sent\n\n@asynccontextmanager\nasync def lifespan(app: FastAPI):\n    app.state.pool = await create_pool()    # startup\n    yield\n    await app.state.pool.close()            # shutdown\n\napp = FastAPI(lifespan=lifespan)",
            "highlights": [
              {
                "at": "before",
                "lines": "2",
                "note": "Setup per request"
              },
              {
                "at": "injected",
                "lines": "4",
                "note": "Injected into the endpoint"
              },
              {
                "at": "teardown",
                "lines": "5-6",
                "note": "Teardown after the response"
              },
              {
                "at": "lifespan",
                "lines": "8-14",
                "note": "App-wide startup / shutdown"
              }
            ]
          }
        },
        {
          "type": "recap",
          "say": "To recap. FastAPI reads your signature to parse and validate requests, answering four twenty-two on bad input. Dependencies are injected and cached per request, and response models filter what goes out. Use async endpoints only with awaitable calls, and plain functions for blocking ones. And manage resources with yield dependencies and a lifespan.",
          "props": {
            "title": "FastAPI, <em>in four lines</em>",
            "items": [
              {
                "at": "signature",
                "text": "The signature drives parsing, validation, and docs.",
                "code": "422 on bad input"
              },
              {
                "at": "injected",
                "text": "Dependencies injected; response models filter output.",
                "code": "Depends · response_model"
              },
              {
                "at": "awaitable",
                "text": "async def only with awaitables; else plain def.",
                "code": "thread pool · 40"
              },
              {
                "at": "lifespan",
                "text": "yield dependencies and lifespan manage resources.",
                "code": "setup · teardown"
              }
            ]
          }
        }
      ]
    }
