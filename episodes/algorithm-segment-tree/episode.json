        {
          "type": "code",
          "say": "Here's the whole structure. Build fills each node from its children. Query has three cases: outside returns zero, the identity for sum, inside returns the node, and partial splits at mid. Update walks to the leaf, and re-merges on the way back. To get min or max instead of sum, change the merge, and the identity.",
          "props": {
            "title": "The <em>code</em>",
            "file": "segtree.cpp",
            "tag": "C++",
            "lang": "cpp",
            "size": 19,
            "width": 1250,
            "code": "struct SegTree {\n    int n;\n    vector<long long> t;                     // node i: children 2i, 2i+1\n    SegTree(const vector<int>& a) : n(a.size()), t(4 * a.size()) {\n        build(a, 1, 0, n - 1);\n    }\n    void build(const vector<int>& a, int node, int lo, int hi) {\n        if (lo == hi) { t[node] = a[lo]; return; }\n        int mid = lo + (hi - lo) / 2;\n        build(a, 2 * node, lo, mid);\n        build(a, 2 * node + 1, mid + 1, hi);\n        t[node] = t[2 * node] + t[2 * node + 1];\n    }\n    long long query(int node, int lo, int hi, int l, int r) {\n        if (r < lo || hi < l) return 0;            // outside: identity\n        if (l <= lo && hi <= r) return t[node];    // inside: whole node\n        int mid = lo + (hi - lo) / 2;              // partial: split\n        return query(2 * node, lo, mid, l, r)\n             + query(2 * node + 1, mid + 1, hi, l, r);\n    }\n    void update(int node, int lo, int hi, int idx, long long val) {\n        if (lo == hi) { t[node] = val; return; }\n        int mid = lo + (hi - lo) / 2;\n        if (idx <= mid) update(2 * node, lo, mid, idx, val);\n        else            update(2 * node + 1, mid + 1, hi, idx, val);\n        t[node] = t[2 * node] + t[2 * node + 1];   // recompute on the way up\n    }\n};",
