        {
          "type": "points",
          "say": "Why so few nodes? At each level, only the nodes holding the query's two ends can be partial. Everything between them is fully inside, and returns at once, or fully outside. So a query visits at most about four nodes per level, over log n levels. Building is O of n: each node is computed once, from its two children. And no pointers: node i has children two i, and two i plus one. Allocate four n slots to be safe.",
          "props": {
            "title": "Why <em>O(log N)</em>",
            "items": [
              {
                "at": "ends",
                "label": "Per level",
                "title": "At most 2 partial nodes",
                "body": "Only the two ends of the query split; the middle returns at once.",
                "code": "≤ 4 nodes per level"
              },
              {
                "at": "Building",
                "label": "Build",
                "title": "O(N), bottom-up",
                "body": "Each node is the merge of its two children.",
                "code": "t[i] = t[2i] + t[2i+1]"
              },
              {
                "at": "pointers",
                "label": "Layout",
                "title": "A plain array",
                "body": "Root at 1; children of i at 2i and 2i+1.",
                "code": "vector<long long> t(4 * n)"
              }
            ]
          }
        }
