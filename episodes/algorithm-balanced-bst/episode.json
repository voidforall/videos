    {
      "id": "02",
      "title": "The four AVL cases",
      "question": "When does an AVL tree rotate, and which rotation does it use?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. When does an AVL tree rotate, and how does it pick the rotation? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "When does an AVL tree rotate, and <em>which</em> rotation?"
          }
        },
        {
          "type": "points",
          "say": "An AVL tree keeps one rule: at every node, the two subtree heights differ by at most one. The balance factor is left height minus right height, so it must stay between minus one and one. That bounds the height at about one point four four log n. After an insert, walk back up. The first node that hits plus or minus two is fixed by one of four cases. Straight lines, left-left or right-right, take one rotation. Zigzags, left-right or right-left, take two.",
          "props": {
            "title": "Balance factor in <em>{−1, 0, +1}</em>",
            "items": [
              {
                "at": "rule",
                "label": "Invariant",
                "title": "Heights differ by ≤ 1",
                "body": "bf = height(left) − height(right).",
                "code": "h ≤ 1.44 log₂ N"
              },
              {
                "at": "Straight",
                "label": "LL / RR",
                "title": "One rotation",
                "body": "bf ±2 and the child leans the same way.",
                "code": "rotateRight / rotateLeft"
              },
              {
                "at": "Zigzags",
                "label": "LR / RL",
                "title": "Two rotations",
                "body": "The child leans the other way: straighten it first.",
                "code": "rotate child, then node"
              }
            ]
          }
        },
        {
          "type": "graph",
          "say": "Here's the zigzag. Insert twenty-five. It goes right of twenty, left of forty, then left of thirty. Now twenty's right side is two levels taller: balance minus two. But its right child, forty, leans left. A single left rotation at twenty would just make a mirror-image zigzag. So first rotate right at forty: thirty comes up, and the zigzag becomes a straight line. Then rotate left at twenty: thirty becomes the root. Every balance factor is back within one.",
          "props": {
            "title": "The right-left <em>case</em>",
            "nodes": [
