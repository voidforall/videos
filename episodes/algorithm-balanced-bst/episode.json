    {
      "id": "03",
      "title": "Red-black rules",
      "question": "What are the red-black rules, and how does an insert restore them?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. What are the red-black tree rules, and how does an insert restore them? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "What are the <em>red-black</em> rules?"
          }
        },
        {
          "type": "points",
          "say": "Every node is red or black, and the root is black. A red node can't have a red child. And every path from a node down to an empty leaf passes the same number of black nodes: its black height. Together, these bound the height. The shortest path is all black. The longest alternates red and black, so it's at most twice as long. That gives a height of at most two log of n plus one.",
          "props": {
            "title": "Three rules, <em>2× height</em>",
            "items": [
              {
                "at": "root",
                "label": "Colors",
                "title": "Red or black; root black",
                "body": "Empty leaves count as black."
              },
              {
                "at": "child",
                "label": "No red-red",
                "title": "A red node has black children",
                "body": "Reds can't stack up."
              },
              {
                "at": "passes",
                "label": "Black height",
                "title": "Same count on every path",
                "body": "Every downward path to a leaf."
              },
              {
                "at": "twice",
                "label": "Height",
                "title": "Longest ≤ 2 × shortest",
                "body": "Reds only interleave blacks.",
                "code": "h ≤ 2 log₂(N + 1)"
              }
            ]
          }
        },
        {
          "type": "graph",
          "say": "A new node is always red, so black heights never change, and the only possible problem is red under red. Insert ten: it's the root, so color it black. Twenty is red, under a black parent: fine. Thirty is red under red. Its uncle is empty, which counts as black. So rotate left at ten, and swap colors: twenty black, ten red. Now insert fifteen, under ten: red under red again. This time the uncle, thirty, is red. Just recolor: parent and uncle turn black, and the grandparent turns red. Twenty is the root, so it goes back to black. Recoloring can push the problem up, but an insert never needs more than two rotations.",
          "props": {
            "title": "Insert <em>fix-up</em>",
            "nodes": [
              {
                "id": "10",
                "x": 710,
                "y": 290,
                "hidden": true
              },
