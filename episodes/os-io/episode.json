        {
          "type": "points",
          "say": "Nginx serves static files this way, once you turn sendfile on: it's off by default. Kafka hands log segments to consumers with it. Splice generalizes the idea to any two descriptors, through a pipe, which suits proxies. The limit: since the CPU never sees the data, it can't transform it. Encryption used to rule it out, but kernel TLS now encrypts inside the kernel, so even HTTPS can use sendfile.",
          "props": {
            "title": "Where it's <em>used</em>",
            "items": [
              {
                "at": "static",
                "label": "Nginx",
                "title": "Static files",
                "body": "Turn it on: sendfile is off by default.",
                "code": "sendfile on;"
              },
              {
                "at": "Kafka",
                "label": "Kafka",
                "title": "Log segments to consumers",
                "body": "Java transferTo → sendfile.",
                "code": "consumer fetch"
              },
              {
                "at": "Splice",
                "label": "splice",
                "title": "Any two fds, via a pipe",
                "body": "Socket → pipe → socket, for proxies.",
                "code": "splice(2)"
              },
              {
                "at": "transform",
                "label": "Limit",
                "title": "No transforming",
                "body": "TLS only via kernel TLS (kTLS).",
                "code": "SSL_sendfile"
              }
            ]
