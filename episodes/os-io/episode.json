    {
      "id": "01",
      "title": "A read(), end to end",
      "question": "What happens between calling read() on a file and getting the bytes back?",
      "scenes": [
        {
          "type": "question",
          "say": "Input and output, question one. You call read on a file. What happens between that call and the bytes landing in your buffer? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "What happens inside a <em>read()</em>?"
          }
        },
        {
          "type": "graph",
          "say": "Read traps into the kernel, which turns the file descriptor into an open file, and checks the buffer. Then it looks in the page cache: the kernel's cache of file contents. On a hit, it copies the bytes into your buffer, and returns, with no disk at all. On a miss, it adds a page to the cache, and sends a block I/O request to the device. Your thread sleeps. The device writes the data straight into that page, by DMA, then raises an interrupt. The handler marks the page ready, and wakes your thread, which copies the bytes out. The kernel also reads ahead, guessing you'll want the next pages too.",
          "props": {
            "title": "Through the <em>page cache</em>",
            "nodes": [
              {
                "id": "app",
                "label": "read(fd, buf, n)",
                "x": 260,
                "y": 300,
                "w": 300,
                "h": 80
              },
              {
                "id": "sys",
                "label": "kernel: fd → file,\ncheck the buffer",
                "x": 660,
                "y": 300,
                "w": 320,
                "h": 96,
                "hidden": true
              },
              {
                "id": "cache",
                "label": "page cache",
                "x": 1060,
                "y": 300,
                "w": 260,
                "h": 80,
                "hidden": true
              },
              {
                "id": "bio",
                "label": "block I/O request\nthread sleeps",
                "x": 1500,
                "y": 300,
                "w": 320,
                "h": 96,
                "hidden": true
              },
              {
                "id": "dev",
                "label": "SSD: DMA into\nthe cache page",
                "x": 1500,
                "y": 600,
                "w": 300,
                "h": 96,
                "hidden": true
              },
              {
                "id": "irq",
                "label": "interrupt:\npage ready, wake",
                "x": 660,
                "y": 600,
                "w": 300,
                "h": 96,
                "hidden": true
              }
            ],
            "edges": [],
            "panels": [],
            "steps": [
              {
