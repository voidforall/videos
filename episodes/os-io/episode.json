        {
          "type": "recap",
          "say": "To recap. Read goes through the page cache, and waits for the device only on a miss. Write returns once the bytes are cached: f sync makes them durable. Epoll returns only ready descriptors, and io uring batches operations through shared rings. And sendfile keeps the data inside the kernel.",
          "props": {
            "title": "I/O, <em>in four lines</em>",
            "items": [
              {
                "at": "miss",
                "text": "read: page cache; the device only on a miss.",
                "code": "read-ahead"
              },
              {
                "at": "durable",
                "text": "write returns when cached; fsync for durability.",
                "code": "dirty writeback"
              },
              {
                "at": "batches",
                "text": "epoll: ready fds. io_uring: batched, shared rings.",
                "code": "readiness vs completion"
              },
              {
                "at": "inside",
                "text": "sendfile keeps data in the kernel.",
                "code": "zero-copy"
              }
            ]
          }
