                "id": "web",
                "label": "Web server",
                "x": 860,
                "y": 470,
                "w": 260,
                "h": 70
              },
              {
                "id": "cache",
                "label": "Cache",
                "x": 1420,
                "y": 310,
                "w": 260,
                "h": 70
              },
              {
                "id": "db",
                "label": "Database",
                "x": 1420,
