              }
            ],
            "panels": [],
            "steps": [
              {
                "at": "sends",
                "nodes": {
                  "client": "active"
                },
                "edges": {
                  "client-web": "relax"
                },
                "note": "GET /g8 reaches a web server"
              },
              {
                "at": "first",
                "nodes": {
                  "client": "base",
                  "web": "active"
                },
                "edges": {
                  "client-web": "base",
                  "web-cache": "relax"
                },
                "note": "Look up g8 in the cache first"
              },
