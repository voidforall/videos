        {
          "type": "compare",
          "say": "Which redirect? A three oh one is permanent. Browsers cache it, so repeat clicks never reach you: cheaper, but you lose click analytics. A three oh two is temporary, so every click comes back through your servers, and you can count it.",
          "props": {
            "title": "301 or <em>302</em>?",
            "left": {
              "at": "permanent",
              "label": "301",
              "title": "Moved permanently",
              "body": "Browsers cache it: repeat clicks skip your servers. Least load, but clicks go uncounted."
            },
            "right": {
              "at": "temporary",
              "label": "302",
              "title": "Found (temporary)",
              "tone": "good",
              "body": "Every click comes back through you, so you can count, geo-locate and expire links."
            },
            "verdict": {
              "at": "count",
              "text": "Need analytics? 302. Pure offload? 301.",
              "code": "Location: <long URL>"
            }
          }
