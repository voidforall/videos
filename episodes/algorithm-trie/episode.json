    {
      "id": "02",
      "title": "The code",
      "question": "Implement insert, search, and startsWith.",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. Implement insert, search, and starts-with. Pause and sketch it out.",
          "pauseAfter": 4,
          "props": {
            "question": "Implement <em>insert</em>, <em>search</em>, and <em>startsWith</em>."
          }
        },
        {
          "type": "code",
          "say": "Each node holds twenty-six child pointers and an end flag. Insert walks the word, creating a child whenever one is missing, then sets the flag on the last node. Search walks the same way and fails as soon as a child is missing. At the end, search returns the flag. Starts-with is identical, except it returns true without checking the flag.",
          "props": {
            "title": "A trie <em>in code</em>",
            "file": "trie.cpp",
            "tag": "O(L) per operation",
            "size": 20,
            "width": 1060,
            "code": "struct Node {\n    Node* child[26] = {};\n    bool end = false;\n};\nvoid insert(Node* root, const string& w) {\n    Node* cur = root;\n    for (char c : w) {\n        int i = c - 'a';\n        if (!cur->child[i]) cur->child[i] = new Node();\n        cur = cur->child[i];\n    }\n    cur->end = true;\n}\nNode* walk(Node* root, const string& s) {\n    Node* cur = root;\n    for (char c : s)\n        if (!(cur = cur->child[c - 'a'])) return nullptr;\n    return cur;\n}\nbool search(Node* r, const string& w) { auto n = walk(r, w); return n && n->end; }\nbool startsWith(Node* r, const string& p) { return walk(r, p) != nullptr; }",
            "highlights": [
              {
                "at": "holds",
                "lines": "1-4",
                "note": "26 children + an end-of-word flag"
              },
              {
                "at": "creating",
                "lines": "9-10",
                "note": "Create missing children while walking"
              },
              {
                "at": "sets",
                "lines": "12",
                "note": "Mark the last node as a word"
              },
              {
                "at": "fails",
                "lines": "17",
                "note": "A missing child means no match"
              },
              {
                "at": "returns",
                "lines": "20",
                "note": "search: the path must end on a word"
              },
              {
                "at": "identical",
                "lines": "21",
                "note": "startsWith: the path alone is enough"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "03",
      "title": "When a trie wins",
      "question": "When would you choose a trie over a hash set of strings?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. When would you choose a trie over a hash set of strings? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "When does a trie beat a <em>hash set</em> of strings?"
          }
        },
        {
          "type": "points",
          "say": "Whenever prefixes matter. Autocomplete collects every word below a prefix node. A spell checker or word game prunes a search the moment a prefix dies. The longest common prefix is the path before the first branch. And a bitwise trie over zeros and ones answers maximum XOR queries greedily, bit by bit.",
          "props": {
            "title": "When <em>prefixes</em> matter",
            "items": [
              {
                "at": "autocomplete",
                "label": "Typeahead",
                "title": "Autocomplete",
                "body": "Every word below a prefix node.",
                "code": "LC 642"
              },
              {
                "at": "prunes",
                "label": "Pruning",
                "title": "Word search",
                "body": "Stop as soon as no word has the prefix.",
                "code": "LC 212"
              },
              {
                "at": "longest",
                "label": "Shared prefix",
                "title": "Longest common prefix",
                "body": "The path before the first branch.",
                "code": "LC 14"
              },
              {
                "at": "bitwise",
                "label": "0/1 trie",
                "title": "Maximum XOR",
                "body": "Prefer the opposite bit at each level.",
                "code": "LC 421"
              }
            ]
          }
        },
        {
          "type": "statement",
          "say": "Every operation costs O of L, the length of the word, no matter how many words are stored. The price is memory: up to twenty-six pointers per node.",
          "props": {
            "text": "O(L), <em>independent of N</em>.",
            "sub": "Insert, search, and prefix checks cost the word length, not the dictionary size. The trade-off is memory: up to 26 child pointers per node.",
            "subAt": "memory"
          }
        }
      ]
    }
