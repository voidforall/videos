    {
      "id": "01",
      "title": "Idempotency keys",
      "question": "A charge request times out and the client retries. How do you avoid charging twice?",
      "scenes": [
        {
          "type": "question",
          "say": "Payment gateway, question one. A charge request times out, and the client retries. How do you make sure the card is not charged twice? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "The client <em>retries</em> a timed-out charge. How do you not charge twice?"
          }
        },
        {
          "type": "graph",
          "say": "The client generates a unique idempotency key, and sends it as a header with the charge. The API records the key before doing any work, then charges the card, and stores the response under that key. Now the response is lost, in a network timeout. The client cannot know whether it was charged, so it retries, with the same key. The API finds the key, and replays the stored response, without charging again. The card is charged exactly once.",
          "props": {
            "title": "Same key, <em>same answer</em>",
            "nodes": [
              {
                "id": "client",
                "label": "Merchant\nserver",
                "x": 180,
                "y": 470,
                "w": 200,
                "h": 90
              },
              {
                "id": "api",
                "label": "Payment\nAPI",
                "x": 660,
                "y": 470,
                "w": 200,
                "h": 90
              },
              {
                "id": "store",
                "label": "Idempotency\nkeys",
                "x": 1050,
                "y": 300,
                "w": 240,
                "h": 90
              },
              {
                "id": "card",
                "label": "Card network",
                "x": 1050,
                "y": 640,
                "w": 240,
                "h": 70
              }
            ],
            "edges": [
              {
                "from": "client",
                "to": "api",
                "w": "POST /charges"
              },
              {
                "from": "api",
                "to": "store"
              },
              {
                "from": "api",
                "to": "card"
              }
            ],
            "panels": [
              {
                "key": "key",
                "label": "Stored under k_7f3",
                "type": "list",
                "initial": []
              },
              {
                "key": "charges",
                "label": "Card charged",
                "type": "list",
                "initial": []
              }
            ],
            "steps": [
              {
                "at": "header",
                "nodes": {
                  "client": "active"
                },
                "edges": {
                  "client-api": "relax"
                },
                "note": "Header: Idempotency-Key: k_7f3"
              },
              {
