                    "$50 × 1"
                  ]
                },
                "note": "Charge the card"
              },
              {
                "at": "stores",
                "nodes": {
                  "card": "base",
                  "store": "done"
                },
                "edges": {
                  "api-card": "base",
                  "api-store": "relax"
                },
                "panels": {
                  "key": [
                    "200 · ch_42"
                  ]
                },
                "note": "Save the response under the key"
              },
              {
                "at": "lost",
                "add": [
                  {
                    "from": "api",
                    "to": "client",
                    "w": "200 ch_42"
                  }
                ],
                "nodes": {
                  "store": "base"
                },
                "edges": {
                  "api-store": "base",
                  "api-client": "dim"
                },
                "note": "The response is lost: timeout"
              },
              {
                "at": "retries",
                "nodes": {
                  "client": "active"
                },
                "edges": {
                  "client-api": "relax"
                },
                "note": "Retry with the same key"
              },
              {
                "at": "finds",
                "nodes": {
                  "client": "base",
                  "store": "active"
                },
                "edges": {
                  "client-api": "base",
                  "api-store": "relax"
                },
                "note": "Key found: no new charge"
              },
              {
                "at": "replays",
                "nodes": {
                  "store": "base",
                  "client": "done"
                },
                "edges": {
                  "api-store": "base",
                  "api-client": "tree"
                },
                "note": "Replay the stored 200 · ch_42"
              },
              {
                "at": "exactly",
                "nodes": {
                  "card": "done"
                },
                "panels": {
                  "charges": [
                    "$50 × 1 ✓"
                  ]
                },
                "note": "Charged exactly once"
              }
            ]
          }
        },
        {
          "type": "points",
          "say": "Four details interviewers probe. The key is generated by the client, usually a random UUID per operation. If the same key arrives with a different body, reject it, rather than replaying. If the first request is still in flight, return a conflict, so two retries can never race. And keys expire, after about twenty-four hours.",
          "props": {
            "title": "The <em>fine print</em>",
            "items": [
              {
                "at": "generated",
                "label": "Who makes it",
                "title": "The client",
                "body": "A random UUID per logical operation.",
                "code": "Idempotency-Key"
              },
              {
                "at": "different",
                "label": "Same key, new body",
                "title": "Reject",
                "body": "Parameters must match the original request.",
                "code": "error, not replay"
              },
              {
                "at": "flight",
                "label": "Still running",
                "title": "Conflict",
                "body": "Concurrent retries must not both proceed.",
                "code": "409 Conflict"
              },
              {
                "at": "expire",
                "label": "Retention",
                "title": "~24 hours",
                "body": "Longer than any client's retry window.",
                "code": "TTL 24h"
              }
            ]
          }
        }
      ]
    },
