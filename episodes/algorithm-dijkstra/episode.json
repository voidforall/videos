      "title": "Relax and commit",
      "question": "What does Dijkstra commit to at each step, and why is that safe?",
      "scenes": [
        {
          "type": "question",
          "say": "Dijkstra, question one. What does the algorithm commit to at each step, and why is that safe? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "What does Dijkstra <em>commit</em> to at each step, and why is it safe?"
          }
        },
        {
          "type": "points",
          "say": "Three ideas. Relaxation: if going through u gives v a shorter distance, update it. A min-heap always hands you the closest unfinished vertex. And the greedy invariant: when a vertex leaves the heap, its distance is final, because with non-negative weights no later path can be shorter.",
          "props": {
            "title": "Three <em>ideas</em>",
            "items": [
              {
                "at": "relaxation",
                "label": "Relax",
                "title": "Try a shorter path",
                "body": "Through u, can v get closer?",
                "code": "dist[v] = min(dist[v], dist[u] + w)"
              },
              {
                "at": "heap",
                "label": "Min-heap",
                "title": "Closest first",
                "body": "Always expand the nearest unfinished vertex.",
                "code": "(distance, vertex)"
              },
              {
                "at": "invariant",
                "label": "Invariant",
                "title": "Popped means final",
                "body": "Non-negative weights: nothing later can beat it.",
                "code": "w ≥ 0"
              }
            ]
          }
        },
