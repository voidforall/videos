                "w": 240,
                "h": 64,
                "hidden": true
              },
              {
                "id": "heap",
                "label": "heap: \"hello\"",
                "x": 780,
                "y": 480,
                "w": 300,
                "h": 90
              }
            ],
            "edges": [
              {
                "from": "s1",
                "to": "heap"
              }
            ],
            "panels": [
              {
