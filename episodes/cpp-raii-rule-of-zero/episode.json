    {
      "id": "03",
      "title": "The rule of zero",
      "question": "How do you avoid writing any of the five special members?",
      "scenes": [
        {
          "type": "question",
          "say": "Question three. How do you avoid writing any of the five special members at all? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "How do you avoid writing <em>any</em> of the five?"
          }
        },
        {
          "type": "compare",
          "say": "The rule of zero is the modern default. Don't manage resources in your class at all. Hold them in members that already manage themselves: string, vector, unique pointer. Then the compiler-generated copy, move, and destructor are all correct, and you write none of them. Keep the rule of five for the rare low-level class whose only job is owning a resource.",
          "props": {
            "title": "Five functions, <em>or none</em>",
            "left": {
              "at": "rare",
              "label": "Rule of five",
              "title": "You own the raw resource",
              "code": "class GoodString {\n  char* data_; size_t size_;\npublic:\n  ~GoodString();\n  GoodString(const GoodString&);\n  GoodString& operator=(const GoodString&);\n  GoodString(GoodString&&) noexcept;\n  GoodString& operator=(GoodString&&) noexcept;\n};",
              "body": "Rare: low-level owning types only."
            },
            "right": {
              "at": "hold",
              "label": "Rule of zero",
              "title": "Members own themselves",
              "tone": "good",
              "code": "class Profile {\n  int id_;\n  std::string name_;\n  std::vector<int> scores_;\n  std::unique_ptr<Cache> cache_;\n  // no special members at all\n};",
              "body": "Copy, move, destroy: all generated correctly."
            },
            "verdict": {
              "at": "none",
              "text": "Compose from types that already manage themselves.",
              "code": "the default"
            }
          }
        },
        {
          "type": "recap",
          "say": "To recap. Acquire in the constructor, and release in the destructor. Destructors run during stack unwinding, so cleanup is automatic. If you manage a raw resource, write all five special members. Otherwise, follow the rule of zero.",
          "props": {
            "title": "RAII, <em>in four lines</em>",
            "items": [
              {
                "at": "acquire",
                "text": "Acquire in the constructor, release in the destructor.",
