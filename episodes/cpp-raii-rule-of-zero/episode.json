        {
          "type": "recap",
          "say": "That is the rule of three, extended to five in C plus plus eleven. If you write any of the destructor, the copy constructor, or copy assignment, you almost certainly need all of them. And for speed, add the move constructor and move assignment too.",
          "props": {
            "title": "The five <em>special members</em>",
            "items": [
              {
                "at": "destructor",
                "text": "Destructor",
                "code": "~T()"
              },
              {
                "at": "constructor",
                "text": "Copy constructor: deep copy",
                "code": "T(const T&)"
              },
              {
                "at": "assignment",
                "text": "Copy assignment: copy-and-swap",
                "code": "T& operator=(const T&)"
              },
              {
                "at": "speed",
                "text": "Move constructor: steal, null the source",
                "code": "T(T&&) noexcept"
              },
              {
                "at": "assignment#2",
                "text": "Move assignment",
                "code": "T& operator=(T&&) noexcept"
              }
            ]
