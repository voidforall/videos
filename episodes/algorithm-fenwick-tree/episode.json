        {
          "type": "points",
          "say": "The lowest set bit is one expression: i and minus i. In two's complement, minus i is not i plus one. Take six: zero one one zero. Flipping gives one zero zero one, and adding one carries up to the lowest set bit: one zero one zero. Every bit above it differs from six, so i and minus i keeps only that bit: two.",
          "props": {
            "title": "lowbit(i) = <em>i & -i</em>",
            "items": [
              {
                "at": "six",
                "label": "Start",
                "title": "6 = 0110",
                "body": "The value whose lowest set bit we want."
              },
              {
                "at": "Flipping",
                "label": "Negate",
                "title": "−6 = 1001 + 1 = 1010",
                "body": "The carry stops at the lowest set bit."
              },
              {
                "at": "keeps",
                "label": "And",
                "title": "6 & −6 = 0010 = 2",
                "body": "Only the lowest set bit survives.",
                "code": "t[6] covers a[5..6]"
              }
            ]
          }
        }
      ]
