                  }
                },
                "note": "W2 crashes in the middle of t7"
              },
              {
                "at": "missed",
                "panels": {
                  "hb": {
                    "W2": "9s"
                  }
                },
                "note": "Three missed heartbeats…"
              },
              {
                "at": "dead",
                "nodes": {
                  "sched": "active"
                },
                "panels": {
                  "task": [
                    "failed: W2 dead"
                  ]
                },
                "note": "…W2 marked dead, t7 marked failed"
              },
              {
                "at": "reschedules",
                "add": [
                  {
                    "from": "sched",
                    "to": "W3",
                    "w": "t7"
                  }
                ],
                "nodes": {
                  "sched": "base",
                  "W3": "active"
                },
                "edges": {
                  "sched-W3": "relax"
                },
                "panels": {
                  "task": [
