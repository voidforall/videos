    {
      "id": "02",
      "title": "When a worker dies",
      "question": "A worker dies mid-task. How do you notice, and what happens to the task?",
      "scenes": [
        {
          "type": "question",
          "say": "Question two. A worker dies in the middle of a task. How does the scheduler notice, and what happens to the task? Pause and answer out loud.",
          "pauseAfter": 3,
          "props": {
            "question": "A worker dies <em>mid-task</em>. How do you notice, and then what?"
          }
        },
        {
          "type": "graph",
          "say": "Every worker sends a heartbeat every few seconds, carrying its free resources. W2 is running task t7, when it crashes, and its heartbeats stop. After three missed heartbeats, the scheduler marks W2 dead, marks t7 failed, and reschedules it on a healthy worker, W3. But W2 might not be dead at all, only cut off by the network, and still running t7. So the same task can run twice. Tasks must be idempotent, or their writes must carry a fencing token, so a stale worker's results are rejected.",
          "props": {
            "title": "Missed heartbeats, <em>reschedule</em>",
            "nodes": [
              {
                "id": "sched",
                "label": "Scheduler",
                "x": 360,
                "y": 470,
                "w": 250,
                "h": 70
              },
