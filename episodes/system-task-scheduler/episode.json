                "id": "W1",
                "x": 900,
                "y": 290,
                "w": 170,
                "h": 64
              },
              {
                "id": "W2",
                "x": 900,
                "y": 470,
                "w": 170,
                "h": 64
              },
              {
                "id": "W3",
                "x": 900,
                "y": 650,
                "w": 170,
                "h": 64
              }
            ],
            "edges": [
              {
                "from": "W1",
                "to": "sched"
              },
              {
                "from": "W2",
                "to": "sched"
              },
              {
                "from": "W3",
                "to": "sched"
              }
            ],
            "panels": [
              {
                "key": "hb",
                "label": "Since last heartbeat",
                "type": "table",
                "columns": [
                  "W1",
                  "W2",
                  "W3"
                ],
                "initial": {
                  "W1": "1s",
                  "W2": "2s",
                  "W3": "1s"
                }
              },
              {
                "key": "task",
                "label": "Task t7",
                "type": "list",
                "initial": [
                  "running on W2"
                ]
              }
            ],
            "steps": [
              {
                "at": "heartbeat",
                "edges": {
                  "W1-sched": "relax",
                  "W2-sched": "relax",
                  "W3-sched": "relax"
                },
                "note": "Heartbeats every 3 s: alive + free resources"
              },
              {
                "at": "crashes",
                "nodes": {
                  "W2": "dim"
                },
                "edges": {
                  "W1-sched": "base",
                  "W2-sched": "dim",
                  "W3-sched": "base"
                },
                "panels": {
